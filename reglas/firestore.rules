rules_version = '2';

// ═══════════════════════════════════════════════════════════════
// YourLift — Firestore Security Rules
// ═══════════════════════════════════════════════════════════════
// Este archivo es una COPIA de lo que está publicado en el proyecto.
// No se aplica solo: hay que pegarlo en
//   Firebase Console → Firestore Database → Reglas → Publicar
// (o `firebase deploy --only firestore:rules` desde una máquina con la CLI).
//
// Roles:
//   - admins/{uid}   → administradores, acceso completo
//   - coaches/{uid}  → entrenadores, acceso acotado
//   - sin sesión     → lectura de lo público, y escritura solo donde se
//                      permite a propósito (formularios y ensayos)
// ═══════════════════════════════════════════════════════════════

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // Una cuenta DESACTIVADA (disabled:true, desde Admin → Gestión Admin) deja de
    // ser admin para todo: no lee ni escribe nada que pida admin. Se desactiva en
    // vez de borrarse para poder volver a activarla con su mismo rol y nombre.
    function isAdmin() {
      return isSignedIn() &&
             exists(/databases/$(database)/documents/admins/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.get('disabled', false) != true;
    }

    // El OWNER es el admin cuyo documento dice role:'owner'. Es una condición más
    // estricta que isAdmin(): un superadmin es admin pero no es owner.
    function isOwner() {
      return isAdmin() &&
             get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role == 'owner';
    }

    // DATOS PERSONALES (Ley 21.719). Las cuentas de la transmisión, la mesa
    // técnica y los jueces son admin para lo que necesitan en competencia, pero
    // no ven RUT, fechas de nacimiento, documentos ni contactos: no lo usan, y
    // esas cuentas se comparten y se quedan abiertas en equipos del evento.
    function veDatosPersonales() {
      return isAdmin() &&
             !(get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.get('role', '')
               in ['streaming', 'transmision', 'mesa', 'juez']);
    }

    // Lo que nunca va en un documento que se lee sin sesión. La lista es la de
    // compartido/privacidad.js (YLPrivacidad.INSC_PRIVADOS).
    function camposPersonales() {
      return ['rut', 'fechaNac', 'fechanac', 'fechanacimiento', 'dob', 'comuna',
              'declaraMayorFecha', 'carnetName', 'wadeName', 'correo', 'email',
              'correos', 'telefono', 'fono', 'celular', 'pin'];
    }
    // Al crear: no trae ninguno.
    function creaSinPersonales() {
      return !request.resource.data.keys().hasAny(camposPersonales());
    }
    // Al modificar: no agrega ni cambia ninguno (sí puede quitarlos: así se
    // migran los documentos de antes, que los traían).
    function modificaSinPersonales() {
      return !request.resource.data.diff(resource.data).addedKeys().hasAny(camposPersonales())
          && !request.resource.data.diff(resource.data).changedKeys().hasAny(camposPersonales());
    }

    function isCoach() {
      return isSignedIn() &&
             exists(/databases/$(database)/documents/coaches/$(request.auth.uid));
    }

    // Los JUECES van en su propia colección, NO en admins/.
    //
    // Antes la cuenta que usaba un juez en su teléfono estaba en admins/, y para
    // estas reglas eso es acceso total: podía escribir inscripciones, resultados,
    // eventos, todo. El rol 'juez' solo escondía botones en la pantalla, que no es
    // ninguna protección. Un teléfono prestado, o uno que quedó con la sesión
    // abierta después del campeonato, era un admin suelto.
    //
    // Un juez ahora puede exactamente dos cosas: marcar su luz y arrancar el
    // cronómetro. Nada más. Y como no está en admins/, el panel de administración
    // y el control en vivo lo rechazan solos, sin que haya que acordarse de nada.
    function esJuez() {
      return isSignedIn() &&
             exists(/databases/$(database)/documents/jueces/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/jueces/$(request.auth.uid)).data.get('disabled', false) != true;
    }

    // Los eventos de ENSAYO (livecast de prueba) se operan SIN iniciar sesión: su
    // documento se llama ENSAYO_… porque sale del nombre del evento. Se deja
    // escribir a cualquiera para que varias personas prueben a la vez sobre el
    // mismo tablero y vean los cambios en el momento. Son datos descartables:
    // ahí no hay ninguna competencia real, y todo lo demás sigue pidiendo admin.
    //
    // Dos formas de id, porque no todas las colecciones lo arman igual:
    //   livecast_sync / livecast_screen  →  'ENSAYO_Sudamericano_2026'
    //   livecast_director / _record      →  'current__ENSAYO_Sudamericano_2026'
    // Con solo la primera forma, en un ensayo el Control TX no podía escribir y
    // los gráficos de transmisión no se movían: se apretaba el botón, quedaba
    // verde, y a la pantalla no llegaba nada. Que es justo lo que se va a probar
    // en un ensayo.
    //
    // judge_decisions y timer_control quedan afuera a propósito: sus ids son
    // 'current' / 'current_T1' y no dicen de qué evento son, así que no hay forma
    // de distinguir el ensayo de la competencia de verdad. Los jueces igual
    // escriben ahí con su cuenta (esJuez), que es como se usa en el campeonato.
    function esEnsayo(doc) {
      return doc.matches('ENSAYO_.*') || doc.matches('.*__ENSAYO_.*');
    }

    // ── Livecast (sync + widgets de transmisión) ───────────────
    // Un solo bloque por colección: si se repite el match más abajo, las reglas
    // se suman (basta que una permita) y se vuelve difícil de leer.
    match /livecast_sync/{doc}     { allow read: if true; allow write: if isAdmin() || esEnsayo(doc); }
    // livecast_flash: canal rápido del livecast. Lleva solo los atletas que
    // cambiaron y el cursor (pocos KB), para que el peso llegue en menos de un
    // segundo al control remoto, la transmisión y las pantallas del público.
    // livecast_sync (la nómina entera) se sigue escribiendo igual y es la fuente
    // de verdad; si este canal falla, todo llega por el camino de siempre.
    match /livecast_flash/{doc}    { allow read: if true; allow write: if isAdmin() || esEnsayo(doc); }
    match /livecast_director/{doc} { allow read: if true; allow write: if isAdmin() || esEnsayo(doc); }
    match /livecast_screen/{doc}   { allow read: if true; allow write: if isAdmin() || esEnsayo(doc); }
    match /livecast_record/{doc}   { allow read: if true; allow write: if isAdmin() || esEnsayo(doc); }
    // Las dos únicas cosas que puede escribir un juez.
    match /judge_decisions/{doc}   { allow read: if true; allow write: if isAdmin() || esJuez() || esEnsayo(doc); }
    match /timer_control/{doc}     { allow read: if true; allow write: if isAdmin() || esJuez() || esEnsayo(doc); }

    // Las cuentas del panel las maneja SOLO el owner: crearlas, revocarlas,
    // desactivarlas y volver a activarlas. Si cualquier admin pudiera escribir
    // acá, uno desactivado podría ser reactivado por otro, o alguien podría
    // desactivar al owner. Cada uno puede leer su propia ficha, aunque esté
    // desactivada, para que el panel le diga eso y no "acceso denegado".
    // El owner no puede desactivarse a sí mismo: quedaría fuera sin nadie que
    // lo vuelva a activar.
    match /admins/{uid} {
      allow read: if isAdmin() || (isSignedIn() && request.auth.uid == uid);
      allow create, delete: if isOwner();
      allow update: if isOwner() &&
                    !(uid == request.auth.uid && request.resource.data.get('disabled', false) == true);
    }

    // Un juez puede leer su propia ficha (para saber que su cuenta sigue vigente);
    // crearlas y borrarlas es cosa del admin. Desactivarlas y activarlas, del owner.
    match /jueces/{uid} {
      allow read: if isAdmin() || (isSignedIn() && request.auth.uid == uid);
      allow create, delete: if isAdmin();
      allow update: if isAdmin() &&
                    (isOwner() || request.resource.data.get('disabled', false) == resource.data.get('disabled', false));
    }

    match /eventos/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Lo que tiene que cumplir una inscripción enviada desde el formulario público.
    // Se saca aparte porque ahora se usa en dos lugares: al inscribirse por primera
    // vez y al volver a inscribirse después de un rechazo.
    //
    // La inscripción se lee sin sesión (nóminas, livecast, perfil): identifica al
    // atleta por su CÓDIGO, y el RUT, la fecha de nacimiento, la comuna y lo
    // demás personal van en inscripciones_private. El id es {evento}_{código}.
    function inscripcionValida() {
      return request.resource.data.status == 'pending'
          && request.resource.data.nombre is string
          && request.resource.data.nombre.size() > 2
          && request.resource.data.codigo is string
          && request.resource.data.codigo.size() > 3
          && request.resource.data.evento is string
          && creaSinPersonales()
          && !request.resource.data.keys().hasAny(['carnetURL','wadeURL','carnetPhotoURL']);
    }

    match /inscripciones/{id} {
      allow read: if true;
      // También el admin: nada personal en la inscripción pública. Si algún
      // camino del panel se olvidara de separarlo, Firestore lo rechaza.
      allow create: if (isAdmin() && creaSinPersonales()) || inscripcionValida();

      // VOLVER A INSCRIBIRSE DESPUÉS DE UN RECHAZO.
      //
      // El id del documento es `${evento}_${rut}`, así que cuando alguien se
      // inscribe de nuevo escribe SOBRE el documento que ya existe. Para la
      // persona es inscribirse otra vez; para las reglas es un update, y el update
      // era solo de admin. Resultado: "Missing or insufficient permissions" justo
      // al enviar, y solo le pasaba a quien había sido rechazado antes —por eso
      // parecía que el formulario funcionaba bien, porque a los que se inscriben
      // por primera vez sí les funcionaba.
      //
      // Se permite solo si lo que había estaba RECHAZADO y lo nuevo es una
      // inscripción válida. Una inscripción pendiente o aprobada sigue sin poder
      // tocarse desde afuera: para eso está "Editar mi inscripción", que pasa por
      // el admin con el PIN.
      allow update: if (isAdmin() && modificaSinPersonales())
                    || (resource.data.status == 'rejected' && inscripcionValida());
      allow delete: if isAdmin();
    }

    function datosPrivadosValidos() {
      return request.resource.data.keys().hasOnly(['pin','rut','correo','fechaNac','comuna','declaraMayorFecha','carnetName','wadeName',
                                                   'carnetURL','carnetBackURL','wadeURL','carnetPhotoURL','consentimientoURL','passportURL','ipfConsentURL','notasURL','docs','ts'])
          && request.resource.data.pin is string
          && request.resource.data.pin.size() == 4;
    }

    match /inscripciones_private/{id} {
      allow read: if veDatosPersonales();
      allow create: if isAdmin() || datosPrivadosValidos();

      // La otra mitad de volver a inscribirse: los dos documentos se escriben en
      // la misma transacción, así que si uno se permite y el otro no, no se
      // guarda ninguno.
      //
      // Acá se mira el estado del documento PÚBLICO, que es donde vive el
      // 'rejected'. Sin esa condición, cualquiera podría pisarle el PIN a otro:
      // el id se arma con el RUT y adivinarlo es trivial.
      allow update: if isAdmin()
                    || (get(/databases/$(database)/documents/inscripciones/$(id)).data.status == 'rejected'
                        && datosPrivadosValidos());
      allow delete: if isAdmin();
    }

    // ── CAMPEONATOS ABIERTOS ─────────────────────────────────────
    // Un campeonato que no es de la federación (eventos/{id}.abierto == true) se
    // inscribe con su propio formulario, inscripcion_abierta.html: sin sesión,
    // sin RUT ni código de atleta. Lo que llega no se mezcla con las
    // inscripciones de la federación —de ahí salen el padrón, el ranking y los
    // récords— y va a sus propias colecciones.
    //
    // Se acepta solo para un campeonato abierto y con inscripciones abiertas:
    // así nadie usa el formulario para meter nombres en otro campeonato.
    function campeonatoAbierto(ev) {
      return ev is string
          && exists(/databases/$(database)/documents/eventos/$(ev))
          && get(/databases/$(database)/documents/eventos/$(ev)).data.get('abierto', false) == true
          && get(/databases/$(database)/documents/eventos/$(ev)).data.get('status', '') == 'open';
    }
    // Lo público: lo que necesitan la nómina y el livecast. Lista cerrada: un
    // campo de más, o un dato personal, bota la inscripción.
    function inscAbiertaValida() {
      return request.resource.data.keys().hasOnly(['evento','nombre','sexo','anioNac','division','categoria',
                                                   'modalidad','club','clubOtro','status','privacyConsent',
                                                   'privacyConsentTs','timestamp'])
          && request.resource.data.status == 'pending'
          && request.resource.data.privacyConsent == true
          && request.resource.data.nombre is string
          && request.resource.data.nombre.size() > 2
          && request.resource.data.nombre.size() <= 120
          && campeonatoAbierto(request.resource.data.evento);
    }
    match /inscripciones_abiertas/{id} {
      // Se lee sin sesión: de aquí sale la nómina del campeonato en el sitio
      // (nombre, club, división, categoría, modalidad y estado). No hay nada
      // personal: lo personal va en inscripciones_abiertas_priv.
      allow read: if true;
      allow create: if (isAdmin() && creaSinPersonales()) || inscAbiertaValida();
      allow update: if isAdmin() && modificaSinPersonales();
      allow delete: if isAdmin();
    }
    // Lo privado: correo, teléfono, fecha de nacimiento, polera, monto y dónde
    // quedaron la foto y el comprobante. Se escribe en el mismo lote que lo
    // público, y tiene que ser del mismo campeonato.
    function datosAbiertosValidos(id) {
      return request.resource.data.keys().hasOnly(['evento','correo','telefono','fechaNac','polera','talla','monto','docs','ts'])
          && request.resource.data.correo is string
          && request.resource.data.correo.size() <= 120
          && request.resource.data.docs is map
          && request.resource.data.docs.keys().hasOnly(['fotoAtleta','comprobante'])
          && getAfter(/databases/$(database)/documents/inscripciones_abiertas/$(id)).data.evento == request.resource.data.evento;
    }
    match /inscripciones_abiertas_priv/{id} {
      allow read: if veDatosPersonales();
      allow create: if isAdmin() || datosAbiertosValidos(id);
      allow update, delete: if isAdmin();
    }

    // ── FORMULARIOS DE ENTRENADOR ────────────────────────────────
    // Los arma el admin y los lee cualquiera sin sesión: son la definición del
    // formulario que va a llenar el entrenador (qué documentos, hasta cuándo,
    // de qué campeonato si es que hay uno). No cuelgan de un campeonato a
    // propósito: el mismo mecanismo sirve para una convocatoria de acreditación.
    match /formularios_entrenador/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── INSCRIPCIÓN DE ENTRENADORES ──────────────────────────────
    // Un período aparte del de los atletas. El entrenador se inscribe SIN cuenta,
    // igual que el atleta: se identifica por RUT y guarda un PIN. Por eso acá
    // tampoco se puede exigir request.auth != null.
    //
    // Estar acreditado no es requisito para inscribirse —hay organizaciones que no
    // son FECHIPO— así que la regla no lo mira: lo que llega queda 'pending' y lo
    // revisa la organización. Lo que sí se exige es que venga con nombre, RUT,
    // evento y al menos un atleta, y que NO traiga el estado ya aprobado ni datos
    // que no le corresponden.
    function inscEntrenadorValida() {
      return request.resource.data.status == 'pending'
          && request.resource.data.nombre is string
          && request.resource.data.nombre.size() > 2
          && request.resource.data.rut is string
          && request.resource.data.evento is string
          && request.resource.data.atletas is list
          && request.resource.data.atletas.size() <= 60
          // Si es de un campeonato tiene que traer al menos un atleta. En una
          // convocatoria de acreditación no hay atletas que declarar, y exigir
          // uno dejaría el formulario imposible de enviar.
          && (request.resource.data.evento == ''
              || request.resource.data.atletas.size() >= 1)
          && !request.resource.data.keys().hasAny(['pin','correo','telefono','docs','rut']);
    }
    match /inscripciones_entrenador/{id} {
      // El id lleva el RUT del entrenador ({formulario}_{rut}): se puede leer de
      // a uno (el formulario mira si ya se inscribió) pero no listar. La nómina
      // pública sale de publico/entrenadores_nomina, que arma el panel.
      allow get: if true;
      allow list: if veDatosPersonales();
      allow create: if isAdmin() || inscEntrenadorValida();
      // Volver a inscribirse después de un rechazo, igual que el atleta.
      allow update: if isAdmin()
                    || (resource.data.status == 'rejected' && inscEntrenadorValida());
      allow delete: if isAdmin();
    }

    // Lo privado del entrenador: su PIN, su correo, su teléfono y los links de
    // sus documentos. Nunca se lee desde el sitio, solo desde el panel.
    function datosEntrenadorValidos() {
      return request.resource.data.keys().hasOnly(['pin','rut','correo','telefono','docs','ts'])
          && request.resource.data.pin is string
          && request.resource.data.pin.size() == 4;
    }
    match /inscripciones_entrenador_priv/{id} {
      allow read: if veDatosPersonales();
      allow create: if isAdmin() || datosEntrenadorValidos();
      // Los dos documentos se escriben en la misma transacción: si uno se
      // permitiera y el otro no, no se guardaría ninguno.
      allow update: if isAdmin()
                    || (get(/databases/$(database)/documents/inscripciones_entrenador/$(id)).data.status == 'rejected'
                        && datosEntrenadorValidos());
      allow delete: if isAdmin();
    }

    match /edit_requests/{id} {
      allow read, update, delete: if veDatosPersonales();
      allow create: if request.resource.data.keys().hasAll(['inscripcionId','rut','pin','changes','status','ts'])
                    && request.resource.data.keys().hasOnly(['inscripcionId','rut','pin','changes','status','ts'])
                    && request.resource.data.inscripcionId is string
                    && request.resource.data.rut is string
                    && request.resource.data.pin is string
                    && request.resource.data.pin.size() == 4
                    && request.resource.data.changes is map
                    && request.resource.data.status == 'pending';
    }

    match /coaches/{uid} {
      allow read: if veDatosPersonales() || (isSignedIn() && request.auth.uid == uid);
      allow write: if isAdmin();
    }

    // ── Datos personales del padrón ─────────────────────────────
    // El padrón público (data.json) ya no lleva RUT ni fecha de nacimiento
    // completa. Esos dos datos viven acá:
    //   · privado/padron: todos, por código de atleta. Solo lo lee un admin.
    //   · rut_indice/{rut}: RUT → código y fecha, para que el formulario de
    //     inscripción reconozca a quien escribe SU RUT. Se lee de a un
    //     documento (hay que saber el RUT) pero NO se lista: nadie puede bajar
    //     la lista completa. Ver compartido/privacidad.js.
    match /privado/{doc} {
      allow read, write: if veDatosPersonales();
    }
    // rut_indice/{rut} → {codigo}. Solo el código: quien sabe un RUT ajeno no
    // se entera de la fecha de nacimiento ni de nada más. El formulario crea el
    // del atleta NUEVO al inscribirse (una vez: no se puede pisar).
    match /rut_indice/{rut} {
      allow get: if true;
      allow list: if false;
      allow create: if isAdmin()
                    || (request.resource.data.keys().hasOnly(['codigo', 'nuevo'])
                        && request.resource.data.codigo is string
                        && request.resource.data.codigo.size() > 3
                        && request.resource.data.codigo.size() < 40);
      allow update, delete: if isAdmin();
    }

    // Las ediciones del padrón se leen sin sesión (todas las páginas las pegan
    // sobre data.json): sin RUT ni fecha, ni en el id. Lo privado va en
    // athlete_edits_priv, con el mismo id.
    match /athlete_edits/{id} {
      allow read: if true;
      allow create: if isAdmin() && creaSinPersonales();
      allow update: if isAdmin() && modificaSinPersonales();
      allow delete: if isAdmin();
    }
    match /athlete_edits_priv/{id} {
      allow read, write: if veDatosPersonales();
    }

    match /audit_log/{id} {
      allow read: if veDatosPersonales();
      allow create: if isAdmin();
      allow update, delete: if false;
    }

    match /analytics_daily/{day} {
      allow read: if isAdmin();
      allow create, update: if true;
      allow delete: if false;
    }

    match /acreditaciones/{id} {
      allow read: if true;
      allow write: if isAdmin() || isCoach();
    }

    match /competition_results/{id} {
      allow read: if true;
      allow create: if isAdmin() && creaSinPersonales();
      allow update: if isAdmin() && modificaSinPersonales();
      allow delete: if isAdmin();
    }

    // Los AUSPICIADORES son un compromiso comercial: quién sale en el sitio y a
    // dónde lleva su logo. Eso lo decide el owner, no cualquier admin.
    //
    // El panel ya escondía el botón, pero esconder un botón no cierra una puerta:
    // cualquiera con una cuenta de admin podía escribir este documento por fuera.
    // La regla es lo único que de verdad lo impide.
    match /site_backgrounds/sponsors {
      allow read: if true;
      allow write: if isOwner();
    }

    // La foto de portada y su encuadre: los define el owner (panel → Portada).
    match /site_backgrounds/portada {
      allow read: if true;
      allow write: if isOwner();
    }

    match /site_backgrounds/{section} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /atleta_fotos/{codigo} {
      allow read: if true;
      allow create: if isAdmin() && creaSinPersonales();
      allow update: if isAdmin() && modificaSinPersonales();
      allow delete: if isAdmin();
    }

    // Los debutantes (inscritos que todavía no están en data.json), por código:
    // nombre, club, año. El RUT y la fecha completa, en atletas_pending_priv.
    // Los de antes estaban por RUT y con esos datos: la migración los pasa.
    match /atletas_pending/{cod} {
      allow read: if true;
      allow create: if (isAdmin() && creaSinPersonales()) || (
                       request.resource.data.keys().hasOnly(['nombre','codigo','sexo','anioNac','club','zona','debut','inscripcion_evento','ts'])
                    && request.resource.data.nombre is string
                    && request.resource.data.nombre.size() > 2
                    && request.resource.data.codigo == cod
                    );
      allow update: if isAdmin() && modificaSinPersonales();
      allow delete: if isAdmin();
    }
    match /atletas_pending_priv/{cod} {
      allow read, update, delete: if veDatosPersonales();
      allow create: if isAdmin() || (
                       request.resource.data.keys().hasOnly(['rut','fechaNac','ts'])
                    && request.resource.data.rut is string);
    }

    match /atleta_achievements/{codigo} {
      allow read: if true;
      allow write, delete: if isAdmin();
    }

    match /actas/{id} {
      allow read: if true;
      allow write, delete: if isAdmin();
    }

    match /gallery_photos/{id} {
      allow read: if true;
      allow write, delete: if isAdmin();
    }

    match /cronograma/{evento} {
      allow read: if true;
      allow write: if isAdmin();
    }
    // Los correos de los handlers del cronograma (el público ve solo nombres).
    match /cronograma_priv/{evento} {
      allow read, write: if veDatosPersonales();
    }

    match /handlers/{id} {
      allow read: if true;
      allow write: if isSignedIn();
    }
    // Los correos de los handlers que anota un entrenador: los ve el panel y el
    // mismo entrenador que los escribió.
    match /handlers_priv/{id} {
      allow read: if veDatosPersonales() || (isSignedIn() && resource.data.by == request.auth.uid);
      allow create: if veDatosPersonales() || (isSignedIn() && request.resource.data.by == request.auth.uid);
      allow update: if veDatosPersonales() || (isSignedIn() && resource.data.by == request.auth.uid
                    && request.resource.data.by == request.auth.uid);
      allow delete: if isAdmin();
    }

    match /coach_links/{uid} {
      allow read, write: if isSignedIn() && request.auth.uid == uid;
    }

    // La base de entrenadores es por RUT y trae correos: solo el panel. El sitio
    // lee la copia pública (publico/entrenadores) y el formulario de entrenador
    // reconoce a quien escribe SU RUT en entrenadores_indice/{rut} (nombre,
    // club, categoría y vencimiento de la acreditación; sin correos).
    match /entrenadores/{rut} {
      allow read: if veDatosPersonales();
      allow write: if isAdmin();
    }
    match /entrenadores_indice/{rut} {
      allow get: if true;
      allow list: if isAdmin();
      allow write: if isAdmin();
    }

    // Copias públicas que arma el panel (admin/privados.js): entrenadores,
    // jueces y la nómina de entrenadores, sin RUT ni correos.
    match /publico/{doc} {
      allow read: if true;
      allow write: if isAdmin() && creaSinPersonales();
    }

    // Base de jueces del panel, guardada por RUT. Es APARTE de `jueces`, que son
    // las cuentas con las que un juez marca las luces desde el teléfono.
    //
    // Solo la lee el panel: la ficha del atleta muestra la corbata con su
    // categoría desde la copia pública (publico/jueces), por código de atleta y
    // sin RUT. Escribe solo el admin.
    //
    // Faltaba, y por eso la importación de la planilla de FECHIPO agregaba cero
    // jueces: sin un match propio caía en el `allow read, write: if false` del
    // final y Firestore rechazaba las 39 escrituras, una por una.
    match /referees/{rut} {
      allow read: if veDatosPersonales();
      allow write: if isAdmin();
    }

    // Las tarjetas de nómina del inicio de yourlift.cl: foto, nombre del
    // campeonato y la lista que se despliega al tocarla. Las lee cualquiera
    // porque son la portada; las sube el admin. Le faltaba la regla igual que a
    // `referees`.
    match /nomina_cards/{slug} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /records/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Configuración del panel. Hoy guarda qué campeonatos cuentan para el control
    // de participación por año (Revisión inscripciones y Nóminas). No la lee nadie
    // fuera del panel, así que no se abre a lectura pública.
    match /config/{id} {
      allow read, write: if isAdmin();
    }

    // Cobros YourLift (panel → Cobros YourLift): montos y datos de clientes de
    // la plataforma. Solo el owner; ni los otros admins los ven.
    match /cobros/{id} {
      allow read, write: if isOwner();
    }

    // El ciclo del ranking: un solo documento (ranking_config/ciclo) con la fecha
    // desde la que cuentan los resultados. Lo escribe el control en vivo al
    // cerrar el Nacional y lo lee la página pública del ranking, así que la
    // lectura es abierta y la escritura sigue siendo solo de admin.
    match /ranking_config/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /cert_config/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /cert_requests/{id} {
      allow read, update, delete: if veDatosPersonales();
      allow create: if request.resource.data.status == 'pending'
                    && request.resource.data.nombre is string
                    && request.resource.data.nombre.size() > 1
                    && request.resource.data.rut is string;
    }

    match /comp_pos_overrides/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /clubs/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Fotos de la nómina del Sudamericano (incluye extranjeros, sin código ni RUT).
    // Las lee la nómina de yourlift.cl y también el livecast, para mostrar la foto
    // en el perfil del atleta y en Control TX.
    match /nomina_suda_fotos/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Correcciones a la nómina del Sudamericano hechas desde el panel
    // (Admin → Nóminas → "Sudamericano 2026 — nómina FESUPO"): categoría,
    // división, modalidad, lista y bajas. Un solo doc que yourlift.cl aplica
    // encima de nomina_sudamericano.json, así no hay que regenerar el archivo.
    match /nomina_suda_edits/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Actas de campeonatos ya disputados (admin → Competencias pasadas). El
    // público las lee para descargarlas desde yourlift.cl; solo un admin las sube.
    match /competencias_pasadas/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /sugerencias/{id} {
      allow read, delete: if isAdmin();
      allow create: if true;
    }

    // SOLICITUDES SOBRE DATOS PERSONALES (Ley 21.719: acceso, rectificación,
    // supresión, oposición, portabilidad, bloqueo). Cualquiera puede enviar una
    // desde yourlift.cl; solo el panel las lee y las responde. Llega con lo justo
    // para identificar al titular y contestarle.
    match /solicitudes_datos/{id} {
      allow read, update, delete: if veDatosPersonales();
      allow create: if request.resource.data.keys().hasOnly(['tipo','nombre','rut','correo','detalle','status','ts'])
                    && request.resource.data.tipo in ['acceso','rectificacion','supresion','oposicion','portabilidad','bloqueo']
                    && request.resource.data.nombre is string && request.resource.data.nombre.size() > 2
                    && request.resource.data.nombre.size() < 120
                    && request.resource.data.rut is string && request.resource.data.rut.size() < 15
                    && request.resource.data.correo is string && request.resource.data.correo.matches('.+@.+[.].+')
                    && request.resource.data.correo.size() < 120
                    && request.resource.data.detalle is string && request.resource.data.detalle.size() < 2000
                    && request.resource.data.status == 'recibida';
    }

    // Registro de incidentes de seguridad (vulneraciones): qué pasó, qué datos,
    // a cuántos afectó, qué se hizo y cuándo se avisó a la Agencia y a los
    // titulares. Solo el panel.
    match /incidentes/{id} {
      allow read, write: if veDatosPersonales();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
