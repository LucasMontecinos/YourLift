rules_version = '2';

// ═══════════════════════════════════════════════════════════════
// YourLift — Firestore Security Rules
// ═══════════════════════════════════════════════════════════════
// Este archivo es una COPIA de lo que está publicado en el proyecto.
// No se aplica solo: hay que pegarlo en
//   Firebase Console → Firestore Database → Reglas → Publicar
// (o `firebase deploy --only firestore:rules` desde una máquina con la CLI).
//
// Roles:
//   - admins/{uid}   → administradores, acceso completo
//   - coaches/{uid}  → entrenadores, acceso acotado
//   - sin sesión     → lectura de lo público, y escritura solo donde se
//                      permite a propósito (formularios y ensayos)
// ═══════════════════════════════════════════════════════════════

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() &&
             exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // El OWNER es el admin cuyo documento dice role:'owner'. Es una condición más
    // estricta que isAdmin(): un superadmin es admin pero no es owner.
    function isOwner() {
      return isAdmin() &&
             get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role == 'owner';
    }

    function isCoach() {
      return isSignedIn() &&
             exists(/databases/$(database)/documents/coaches/$(request.auth.uid));
    }

    // Los JUECES van en su propia colección, NO en admins/.
    //
    // Antes la cuenta que usaba un juez en su teléfono estaba en admins/, y para
    // estas reglas eso es acceso total: podía escribir inscripciones, resultados,
    // eventos, todo. El rol 'juez' solo escondía botones en la pantalla, que no es
    // ninguna protección. Un teléfono prestado, o uno que quedó con la sesión
    // abierta después del campeonato, era un admin suelto.
    //
    // Un juez ahora puede exactamente dos cosas: marcar su luz y arrancar el
    // cronómetro. Nada más. Y como no está en admins/, el panel de administración
    // y el control en vivo lo rechazan solos, sin que haya que acordarse de nada.
    function esJuez() {
      return isSignedIn() &&
             exists(/databases/$(database)/documents/jueces/$(request.auth.uid));
    }

    // Los eventos de ENSAYO (livecast de prueba) se operan SIN iniciar sesión: su
    // documento se llama ENSAYO_… porque sale del nombre del evento. Se deja
    // escribir a cualquiera para que varias personas prueben a la vez sobre el
    // mismo tablero y vean los cambios en el momento. Son datos descartables:
    // ahí no hay ninguna competencia real, y todo lo demás sigue pidiendo admin.
    function esEnsayo(doc) { return doc.matches('ENSAYO_.*'); }

    // ── Livecast (sync + widgets de transmisión) ───────────────
    // Un solo bloque por colección: si se repite el match más abajo, las reglas
    // se suman (basta que una permita) y se vuelve difícil de leer.
    match /livecast_sync/{doc}     { allow read: if true; allow write: if isAdmin() || esEnsayo(doc); }
    match /livecast_director/{doc} { allow read: if true; allow write: if isAdmin() || esEnsayo(doc); }
    match /livecast_screen/{doc}   { allow read: if true; allow write: if isAdmin() || esEnsayo(doc); }
    match /livecast_record/{doc}   { allow read: if true; allow write: if isAdmin() || esEnsayo(doc); }
    // Las dos únicas cosas que puede escribir un juez.
    match /judge_decisions/{doc}   { allow read: if true; allow write: if isAdmin() || esJuez() || esEnsayo(doc); }
    match /timer_control/{doc}     { allow read: if true; allow write: if isAdmin() || esJuez() || esEnsayo(doc); }

    match /admins/{uid} {
      allow read, write: if isAdmin();
    }

    // Un juez puede leer su propia ficha (para saber que su cuenta sigue vigente);
    // crearlas y borrarlas es cosa del admin.
    match /jueces/{uid} {
      allow read: if isAdmin() || (isSignedIn() && request.auth.uid == uid);
      allow write: if isAdmin();
    }

    match /eventos/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /inscripciones/{id} {
      allow read: if true;
      allow create: if isAdmin() || (
                       request.resource.data.status == 'pending'
                    && request.resource.data.nombre is string
                    && request.resource.data.nombre.size() > 2
                    && request.resource.data.rut is string
                    && request.resource.data.evento is string
                    && !request.resource.data.keys().hasAny(['pin','carnetURL','wadeURL','carnetPhotoURL'])
                  );
      allow update, delete: if isAdmin();
    }

    match /inscripciones_private/{id} {
      allow read: if isAdmin();
      allow create: if request.resource.data.keys().hasOnly(['pin','rut','correo','carnetURL','carnetBackURL','wadeURL','carnetPhotoURL','consentimientoURL','passportURL','ipfConsentURL','notasURL','docs','ts'])
                    && request.resource.data.pin is string
                    && request.resource.data.pin.size() == 4;
      allow update, delete: if isAdmin();
    }

    match /edit_requests/{id} {
      allow read, update, delete: if isAdmin();
      allow create: if request.resource.data.keys().hasAll(['inscripcionId','rut','pin','changes','status','ts'])
                    && request.resource.data.keys().hasOnly(['inscripcionId','rut','pin','changes','status','ts'])
                    && request.resource.data.inscripcionId is string
                    && request.resource.data.rut is string
                    && request.resource.data.pin is string
                    && request.resource.data.pin.size() == 4
                    && request.resource.data.changes is map
                    && request.resource.data.status == 'pending';
    }

    match /coaches/{uid} {
      allow read: if isAdmin() || (isSignedIn() && request.auth.uid == uid);
      allow write: if isAdmin();
    }

    match /athlete_edits/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /audit_log/{id} {
      allow read: if isAdmin();
      allow create: if isAdmin();
      allow update, delete: if false;
    }

    match /analytics_daily/{day} {
      allow read: if isAdmin();
      allow create, update: if true;
      allow delete: if false;
    }

    match /acreditaciones/{id} {
      allow read: if true;
      allow write: if isAdmin() || isCoach();
    }

    match /competition_results/{id} {
      allow read: if true;
      allow create, update: if isAdmin();
      allow delete: if isAdmin();
    }

    // Los AUSPICIADORES son un compromiso comercial: quién sale en el sitio y a
    // dónde lleva su logo. Eso lo decide el owner, no cualquier admin.
    //
    // El panel ya escondía el botón, pero esconder un botón no cierra una puerta:
    // cualquiera con una cuenta de admin podía escribir este documento por fuera.
    // La regla es lo único que de verdad lo impide.
    match /site_backgrounds/sponsors {
      allow read: if true;
      allow write: if isOwner();
    }

    match /site_backgrounds/{section} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /atleta_fotos/{codigo} {
      allow read: if true;
      allow write, delete: if isAdmin();
    }

    match /atletas_pending/{rut} {
      allow read: if true;
      allow create: if isAdmin() || (
                       request.resource.data.keys().hasAll(['nombre','rut','codigo','sexo','debut'])
                    && request.resource.data.nombre is string
                    && request.resource.data.nombre.size() > 2
                    && request.resource.data.rut is string
                    );
      allow update, delete: if isAdmin();
    }

    match /atleta_achievements/{codigo} {
      allow read: if true;
      allow write, delete: if isAdmin();
    }

    match /actas/{id} {
      allow read: if true;
      allow write, delete: if isAdmin();
    }

    match /gallery_photos/{id} {
      allow read: if true;
      allow write, delete: if isAdmin();
    }

    match /cronograma/{evento} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /handlers/{id} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /coach_links/{uid} {
      allow read, write: if isSignedIn() && request.auth.uid == uid;
    }

    match /entrenadores/{rut} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /records/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Configuración del panel. Hoy guarda qué campeonatos cuentan para el control
    // de participación por año (Revisión inscripciones y Nóminas). No la lee nadie
    // fuera del panel, así que no se abre a lectura pública.
    match /config/{id} {
      allow read, write: if isAdmin();
    }

    // El ciclo del ranking: un solo documento (ranking_config/ciclo) con la fecha
    // desde la que cuentan los resultados. Lo escribe el control en vivo al
    // cerrar el Nacional y lo lee la página pública del ranking, así que la
    // lectura es abierta y la escritura sigue siendo solo de admin.
    match /ranking_config/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /cert_config/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /cert_requests/{id} {
      allow read, update, delete: if isAdmin();
      allow create: if request.resource.data.status == 'pending'
                    && request.resource.data.nombre is string
                    && request.resource.data.nombre.size() > 1
                    && request.resource.data.rut is string;
    }

    match /comp_pos_overrides/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /clubs/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Fotos de la nómina del Sudamericano (incluye extranjeros, sin código ni RUT).
    // Las lee la nómina de yourlift.cl y también el livecast, para mostrar la foto
    // en el perfil del atleta y en Control TX.
    match /nomina_suda_fotos/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Correcciones a la nómina del Sudamericano hechas desde el panel
    // (Admin → Nóminas → "Sudamericano 2026 — nómina FESUPO"): categoría,
    // división, modalidad, lista y bajas. Un solo doc que yourlift.cl aplica
    // encima de nomina_sudamericano.json, así no hay que regenerar el archivo.
    match /nomina_suda_edits/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Actas de campeonatos ya disputados (admin → Competencias pasadas). El
    // público las lee para descargarlas desde yourlift.cl; solo un admin las sube.
    match /competencias_pasadas/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /sugerencias/{id} {
      allow read, delete: if isAdmin();
      allow create: if true;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
