{
  "appId": "cl.yourlift.app",
  "appName": "YourLift",
  "webDir": "www",
  "backgroundColor": "#0A1628",
  "appendUserAgent": "YourLiftApp",
  "server": {
    "url": "https://yourlift.cl",
    "allowNavigation": [
      "yourlift.cl",
      "www.yourlift.cl"
    ],
    "errorPath": "sin_conexion.html"
  },
  "android": {
    "allowMixedContent": false
  },
  "ios": {
    "contentInset": "automatic"
  },
  "plugins": {
    "SystemBars": {
      "insetsHandling": "css",
      "style": "DARK"
    },
    "StatusBar": {
      "style": "DARK",
      "backgroundColor": "#0A1628",
      "overlaysWebView": false
    },
    "SplashScreen": {
      "launchShowDuration": 2500,
      "launchAutoHide": true,
      "backgroundColor": "#0A1628",
      "showSpinner": false,
      "androidScaleType": "CENTER_CROP"
    }
  }
}
