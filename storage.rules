rules_version = '2';

// ═══════════════════════════════════════════════════════════════
// YourLift — Firebase Storage Security Rules
// ═══════════════════════════════════════════════════════════════
// Despliegue:
//   firebase deploy --only storage
//   o pegar este archivo en Firebase Console → Storage → Reglas.
//
// Uso esperado de Storage:
//   - athlete_files/{rut}/…   → carnet, WADA, pasaporte (los sube quien se inscribe)
//   - athlete_photos/…        → foto del atleta (ficha, nómina, Control TX)
//   - athlete_gifs/…          → clip corto del atleta para la transmisión
//   - logos/…                 → clubes, eventos, transmisión, auspiciadores
//   - nomina_cards/…          → la foto de la tarjeta de cada campeonato
//   - public/…                → assets del sitio, incluida la foto de cada juez
//   - videos/…                → fondos de sección y de la pantalla de espera
//   - actas/…                 → actas de campeonatos ya disputados
//   - gallery/…               → fotos de eventos (archivos antiguos)
//   - backups/…               → exports del panel (solo admin)
//
// Modelo:
//   - admins (definidos en Firestore /admins/{uid}) leen y escriben todo
//   - lo que se muestra en el sitio se lee sin sesión; lo privado, no
//
// DOS COSAS QUE HAY QUE TENER PRESENTES AL EDITAR ESTE ARCHIVO:
//
// 1. Acá tiene que estar TODA ruta que el código toque. Lo que no calce con ningún
//    match cae en el deny del final y falla con "User does not have permission",
//    que se lee como un problema de la cuenta y no lo es. Así estaban nomina_cards
//    y todo lo que colgaba de logos/ en un subdirectorio.
//
// 2. En Storage, `write` es crear, reemplazar Y BORRAR. Al borrar no hay archivo
//    entrando, así que `request.resource` no existe: si la condición mira
//    `request.resource.size`, el borrado se cae siempre. Por eso el tope de tamaño
//    va en `create, update` y el borrado se permite aparte.
// ═══════════════════════════════════════════════════════════════

service firebase.storage {
  match /b/{bucket}/o {

    // Helper: chequea si el usuario actual es admin
    function isAdmin() {
      return request.auth != null
          && firestore.exists(/databases/(default)/documents/admins/$(request.auth.uid));
    }

    // ── Logos públicos (clubes, federación, auspiciadores, etc.) ──
    // OJO con {allPaths=**} en vez de {file}: {file} calza UN solo segmento, así
    // que logos/clubs/x.webp, logos/event/…, logos/stream/… y logos/sponsors/…
    // no calzaban con nada y caían en el deny del final. Se veía como "no tienes
    // permiso" al subir el logo de un club, que es justo lo que sí corresponde.
    match /logos/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── Tarjetas de la pestaña Nóminas ───────────────────────────
    // La foto que sale en la tarjeta de cada campeonato en yourlift.cl. La sube
    // el admin desde Tarjetas de nóminas, ya convertida a WebP.
    match /nomina_cards/{file} {
      allow read: if true;
      allow create, update: if isAdmin() && request.resource.size < 10 * 1024 * 1024;
      allow delete: if isAdmin();
    }

    // ── Fotos y clips de atletas ─────────────────────────────────
    // Se ven en la ficha del atleta, en la nómina y en Control TX, así que la
    // lectura es abierta. Las sube el admin desde el panel o desde el livecast, y
    // al reemplazar una foto se borra la anterior: por eso el borrado va aparte.
    match /athlete_photos/{file} {
      allow read: if true;
      allow create, update: if isAdmin() && request.resource.size < 10 * 1024 * 1024;
      allow delete: if isAdmin();
    }
    match /athlete_gifs/{file} {
      allow read: if true;
      allow create, update: if isAdmin() && request.resource.size < 30 * 1024 * 1024;
      allow delete: if isAdmin();
    }

    // ── Videos de fondo (secciones del sitio y pantalla de espera) ─
    match /videos/{allPaths=**} {
      allow read: if true;
      allow create, update: if isAdmin() && request.resource.size < 60 * 1024 * 1024;
      allow delete: if isAdmin();
    }

    // ── Public bucket ────────────────────────────────────────────
    // Assets generales (YourLift_logo.png) y la foto de cada juez, que va en
    // public/referees/{rut}.webp y la muestra la ficha del atleta.
    match /public/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── Files de atletas (carnet, WADA, pasaporte) ───────────────
    // OJO: el formulario de inscripción NO pide iniciar sesión. Quien se inscribe
    // sube estos archivos sin cuenta, así que acá no se puede exigir
    // `request.auth != null`: eso deja a todo el mundo sin poder inscribirse.
    //
    // La lectura tampoco puede ser solo de admin: apenas termina de subir, el
    // propio formulario llama a getDownloadURL() para guardar el link en
    // inscripciones_private, y esa llamada necesita permiso de lectura. Sin
    // lectura abierta, la inscripción se cae justo después de subir el carnet.
    //
    // Lo que protege el archivo es el token del link, que no se puede adivinar:
    // solo lo tiene quien lo subió y el admin que lo revisa. Listar la carpeta
    // sigue siendo cosa del panel.
    //
    // El tope de tamaño sí se puede poner sin romper nada —un carnet comprimido a
    // WebP o un PDF escaneado están muy por debajo— y evita que el bucket termine
    // usándose de disco gratis.
    match /athlete_files/{rut}/{file} {
      allow read: if true;
      allow create, update: if request.resource.size < 20 * 1024 * 1024;
      allow delete: if isAdmin();
    }

    // ── Actas de competencias pasadas ────────────────────────────
    // El acta se genera en el livecast (PDF o Excel) y el admin la sube desde
    // admin → Competencias pasadas. Cualquiera puede bajarla desde el sitio.
    match /actas/{allPaths=**} {
      allow read: if true;
      allow create, update: if isAdmin() && request.resource.size < 20 * 1024 * 1024;
      allow delete: if isAdmin();
    }

    // ── Galería de fotos de eventos ──────────────────────────────
    // Queda para las fotos que ya están subidas: hoy la galería se administra
    // desde Firestore (gallery_photos), pero los archivos viejos siguen acá.
    match /gallery/{allPaths=**} {
      allow read: if true;
      allow create, update: if isAdmin() && request.resource.size < 15 * 1024 * 1024;
      allow delete: if isAdmin();
    }

    // ── Backup admin (exports JSON, logs, etc.) ──────────────────
    match /backups/{allPaths=**} {
      allow read, write: if isAdmin();
    }

    // ── Default deny ─────────────────────────────────────────────
    // Cualquier otro path queda bloqueado.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
