rules_version = '2';

// ═══════════════════════════════════════════════════════════════
// YourLift — Firebase Storage Security Rules
// ═══════════════════════════════════════════════════════════════
// Despliegue:
//   firebase deploy --only storage
//   o pegar este archivo en Firebase Console → Storage → Rules.
//
// Uso esperado de Storage:
//   - athlete_files/{rut}/…   → carnet, certificado WADA (privado, lo lee admin)
//   - athlete_photos/…        → foto del atleta (ficha, nómina, Control TX)
//   - athlete_gifs/…          → clip corto del atleta para la transmisión
//   - logos/…                 → clubes, eventos, transmisión, auspiciadores
//   - nomina_cards/…          → la foto de la tarjeta de cada campeonato
//   - videos/sections/…       → videos de fondo de las secciones del sitio
//   - actas/…                 → actas de campeonatos ya disputados
//   - public/…                → cualquier asset público
//   - backups/…               → exports del panel (solo admin)
//
// Modelo:
//   - admins (definidos en Firestore /admins/{uid}) leen y escriben todo
//   - usuarios autenticados pueden subir a athlete_files/{su rut}
//   - lo que se muestra en el sitio se lee sin sesión; lo privado, no
//
// IMPORTANTE: acá tiene que estar TODA ruta que el código toque. Lo que no calce
// con ningún match cae en el deny del final y falla con "User does not have
// permission", que se lee como un problema de la cuenta y no lo es. Así estaban
// nomina_cards y todo lo que colgaba de logos/ en un subdirectorio.
// ═══════════════════════════════════════════════════════════════

service firebase.storage {
  match /b/{bucket}/o {

    // Helper: chequea si el usuario actual es admin
    function isAdmin() {
      return request.auth != null
          && firestore.exists(/databases/(default)/documents/admins/$(request.auth.uid));
    }

    // ── Logos públicos (clubes, federación, auspiciadores, etc.) ──
    // OJO con {allPaths=**} en vez de {file}: {file} calza UN solo segmento, así
    // que logos/clubs/x.webp, logos/event/…, logos/stream/… y logos/sponsors/…
    // no calzaban con nada y caían en el deny del final. Se veía como "no tienes
    // permiso" al subir el logo de un club, que es justo lo que sí corresponde.
    match /logos/{allPaths=**} {
      allow read: if true;
      allow write, delete: if isAdmin();
    }

    // ── Tarjetas de la pestaña Nóminas ───────────────────────────
    // La foto que sale en la tarjeta de cada campeonato en yourlift.cl. La sube
    // el admin desde Tarjetas de nóminas, ya convertida a WebP.
    match /nomina_cards/{file} {
      allow read: if true;
      allow write, delete: if isAdmin()
                    && request.resource.size < 10 * 1024 * 1024;
    }

    // ── Fotos y clips de atletas ─────────────────────────────────
    // Se ven en la ficha del atleta, en la nómina y en Control TX, así que la
    // lectura es abierta. Las sube el admin desde el panel o desde el livecast.
    match /athlete_photos/{file} {
      allow read: if true;
      allow write, delete: if isAdmin()
                    && request.resource.size < 10 * 1024 * 1024;
    }
    match /athlete_gifs/{file} {
      allow read: if true;
      allow write, delete: if isAdmin()
                    && request.resource.size < 30 * 1024 * 1024;
    }

    // ── Videos de fondo de las secciones del sitio ───────────────
    match /videos/{allPaths=**} {
      allow read: if true;
      allow write, delete: if isAdmin()
                    && request.resource.size < 60 * 1024 * 1024;
    }

    // ── Public bucket (assets generales como YourLift_logo.png) ──
    match /public/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── Files de atletas (carnet, WADA, fotos) ───────────────────
    // Solo el atleta dueño (autenticado) puede subir su archivo.
    // Solo admin puede leer (para validar inscripción).
    // Limita a 5 MB y a tipos imagen + PDF.
    match /athlete_files/{rut}/{file} {
      allow read: if isAdmin();
      allow write: if request.auth != null
                    && request.resource.size < 5 * 1024 * 1024
                    && (request.resource.contentType.matches('image/.*')
                        || request.resource.contentType == 'application/pdf');
      allow delete: if isAdmin();
    }

    // ── Actas de competencias pasadas ────────────────────────────
    // El acta se genera en el livecast (PDF o Excel) y el admin la sube desde
    // admin → Competencias pasadas. Cualquiera puede bajarla desde el sitio.
    match /actas/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin()
                    && request.resource.size < 20 * 1024 * 1024;
      allow delete: if isAdmin();
    }

    // ── Backup admin (exports JSON, logs, etc.) ──────────────────
    match /backups/{allPaths=**} {
      allow read, write: if isAdmin();
    }

    // ── Default deny ─────────────────────────────────────────────
    // Cualquier otro path queda bloqueado.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
